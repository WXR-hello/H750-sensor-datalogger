; ******************************************************************************
; *** 分散加载文件：STM32H750XBH6 ***
; *** 代码放在片内 128KB Flash (0x08000000)；数据先用 DTCM，再溢出到 AXI SRAM ***
; ******************************************************************************

LR_IROM1 0x08000000 0x00020000  {    ; 加载域：片内 Flash，128KB
  ER_IROM1 0x08000000 0x00020000  {  ; 执行域：中断向量表 / 代码 / 常量
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; DTCM 128KB（CPU 访问最快，DMA 访问不到）
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x24000000 0x00080000  {  ; AXI SRAM 512KB（DMA 能用，数据溢出放这里）
   *(.sd_dma)                        ; SD 卡专用缓冲区：SDMMC 内部 DMA(IDMA) 搬数据用；
                                     ; 必须放 AXI SRAM（DTCM 是 DMA 访问不到的），
                                     ; 并且在 MPU 里已配成 non-cacheable
   .ANY (+RW +ZI)
  }
}
